# ============================================================
# MySQL Remote / Local Database Configuration
# ============================================================

# Host: IP address or hostname of your MySQL server (e.g., db.example.com, aws-rds-endpoint, or localhost)
DB_HOST=localhost

# Port: Default MySQL port is 3306
DB_PORT=3306

# Database user
DB_USER=root

# Database password
DB_PASSWORD=

# Database name
DB_NAME=todo_db

# SSL connection: Set to true if connecting to AWS RDS, PlanetScale, Aiven, Railway, or remote SSL-enabled MySQL
DB_SSL=false

# Optional connection limit for connection pooling
DB_CONNECTION_LIMIT=10
